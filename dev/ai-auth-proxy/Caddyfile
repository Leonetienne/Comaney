# Dev-only auth in front of the native model server on the Mac
# (docs/src/docs/dev-manual/local-ai-dev-stack.md).
{
	admin off
	auto_https off
}

:8080 {
	# an empty LOCAL_AI_DEV_KEY matches no request, so everything gets 401
	@authorized {
		header Authorization "Bearer {$LOCAL_AI_DEV_KEY}"
		not header Authorization "Bearer "
	}

	handle @authorized {
		reverse_proxy {$LOCAL_AI_UPSTREAM} {
			# the model server accepts only local Host names
			header_up Host localhost
			header_up -Authorization
		}
	}

	handle {
		header Content-Type application/json
		respond `{"error": {"message": "Missing or invalid API key."}}` 401
	}
}
